# ZoDAV settings. Run ./zodav setup to create a real .env with generated
# passwords, or copy this file to .env and replace every CHANGE_ME value.
# Never share or commit .env: it holds your passwords.

# ---- Required ---------------------------------------------------------------
# The password Zotero uses to sign in (24+ letters and digits).
ZODAV_PASSWORD=CHANGE_ME_32_RANDOM_LETTERS_AND_DIGITS
# Auth key from the Tailscale admin console (Settings > Keys, reusable off,
# tagged tag:zodav) or a tagged Headscale pre-auth key. Needed for the first
# start only: once ZoDAV appears on your network the login is stored, and you
# may clear this value (and revoke or let the key expire).
TS_AUTHKEY=CHANGE_ME_tskey-auth-xxxxxxxx

# ---- Access -----------------------------------------------------------------
# Only if you run your own Headscale server; leave empty for Tailscale.
ZODAV_HEADSCALE_URL=
# Machine name on your private network; the address becomes <name>.<your-tailnet>.
ZODAV_HOSTNAME=zodav
# Tailscale tag given to this machine (ignored with Headscale).
ZODAV_TS_TAG=tag:zodav
# Zotero user name.
ZODAV_USERNAME=zotero

# ---- Optional second user ---------------------------------------------------
# For scripts or other apps that need their own login. Leave both empty if unused.
ZODAV_SERVICE_USERNAME=
ZODAV_SERVICE_PASSWORD=

# ---- Alerts -----------------------------------------------------------------
# Where to send a message when something needs attention. Leave everything empty for
# no alerts. You can use one, two or all three ways below; each one gets every alert.
#
# 1) A webhook address (ntfy, Slack, Discord or any service that accepts a POST):
#   ntfy:    https://ntfy.sh/your-secret-topic
#   Slack:   https://hooks.slack.com/services/T000/B000/XXXX
#   Discord: https://discord.com/api/webhooks/0000/XXXX
ZODAV_ALERT_URL=
#
# 2) Telegram. Set both values or neither.
#   a) In Telegram, open a chat with @BotFather, send /newbot and follow the steps.
#      It gives you a token that looks like 123456789:AAExampleTokenFromBotFather.
#   b) Open a chat with your new bot and send it any message (for a group, add the bot
#      to the group and write there).
#   c) In a browser open https://api.telegram.org/bot<TOKEN>/getUpdates (put your token
#      in place of <TOKEN>) and find "chat":{"id":123456789,...}. That number is the chat id
#      (group ids start with a minus sign).
ZODAV_TELEGRAM_BOT_TOKEN=
ZODAV_TELEGRAM_CHAT_ID=
#
# 3) Email through an SMTP server. Setting the host turns it on; FROM and TO are then required.
#   Gmail:    host smtp.gmail.com, port 587, starttls. Use an app password (Google Account >
#             Security > 2-Step Verification > App passwords), not your normal password.
#   Fastmail: host smtp.fastmail.com, port 587, starttls, with an app password.
#   Security: starttls (default, port 587), ssl (port 465) or none (unencrypted, avoid).
#   TO can list several addresses separated by commas.
ZODAV_SMTP_HOST=
ZODAV_SMTP_PORT=587
ZODAV_SMTP_SECURITY=starttls
ZODAV_SMTP_USERNAME=
ZODAV_SMTP_PASSWORD=
ZODAV_SMTP_FROM=
ZODAV_SMTP_TO=
# Example:
# ZODAV_SMTP_HOST=smtp.gmail.com
# ZODAV_SMTP_USERNAME=you@example.com
# ZODAV_SMTP_PASSWORD=abcd efgh ijkl mnop
# ZODAV_SMTP_FROM=you@example.com
# ZODAV_SMTP_TO=you@example.com

# ---- Checks and thresholds --------------------------------------------------
# Hours between automatic checks.
ZODAV_AUDIT_INTERVAL_HOURS=24
# Alert if more than this percent of files disappeared since the last check.
ZODAV_DELETE_ALERT_PERCENT=10
# Alert if nothing was uploaded for this many days.
ZODAV_IDLE_DAYS=30
# Alert if free disk space drops below this many gigabytes.
ZODAV_MIN_FREE_GB=2

# ---- Backups (optional) -----------------------------------------------------
# Uncomment to turn on automatic encrypted backups.
# COMPOSE_PROFILES=backup
# Keep RESTIC_PASSWORD in a password manager: without it the backups cannot be restored.
# RESTIC_PASSWORD=CHANGE_ME_32_RANDOM_LETTERS_AND_DIGITS
# Where backups go. Examples (use one) and the credentials each one needs:
#   Amazon S3 or compatible:  RESTIC_REPOSITORY=s3:s3.amazonaws.com/your-bucket
#       AWS_ACCESS_KEY_ID=...  AWS_SECRET_ACCESS_KEY=...  AWS_DEFAULT_REGION=eu-west-1
#   Backblaze B2:             RESTIC_REPOSITORY=b2:your-bucket:zodav
#       B2_ACCOUNT_ID=...  B2_ACCOUNT_KEY=...
#   Azure Blob Storage:       RESTIC_REPOSITORY=azure:your-container:/zodav
#       AZURE_ACCOUNT_NAME=...  AZURE_ACCOUNT_KEY=...
#   restic REST server:       RESTIC_REPOSITORY=rest:https://backup.example.com/zodav
#       RESTIC_REST_USERNAME=...  RESTIC_REST_PASSWORD=...
# RESTIC_REPOSITORY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# RESTIC_REST_USERNAME=
# RESTIC_REST_PASSWORD=
