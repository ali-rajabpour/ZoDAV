{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "minor and patch updates"
    },
    {
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pinDigest"
      ],
      "automerge": true,
      "platformAutomerge": false
    }
  ]
}
